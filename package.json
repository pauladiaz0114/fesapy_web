    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
