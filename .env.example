# Plantilla de variables de entorno de Fesapy. SOLO nombres, nunca valores.
# 1. Copia este archivo como .env.local y llena los valores. NUNCA subas .env.local a Git.
# 2. En Vercel, carga estas variables en Production y en Preview por separado,
#    con valores DISTINTOS en cada entorno (y distintos a los de tu .env.local).
# 3. Si agregas una variable nueva, agrégala aquí (sin valor) y en src/lib/env.ts.
# Detalle: docs/ARQUITECTURA-Y-SEGURIDAD.md §10.

# ---------- Base de datos (Neon) ----------
# URL "pooled" (el host contiene "-pooler"), con el rol fesapy_app (solo leer/escribir datos).
# Neon → Connect → Connection pooling ACTIVADO. Debe incluir ?sslmode=require
# Local y Preview: rama "development" de Neon. Production: rama "production".
# Para fesapy_app: copiar la URL de neondb_owner y cambiar usuario:contraseña por fesapy_app:<su contraseña>.
DATABASE_URL=

# URL directa (sin "-pooler"), con el rol dueño. SOLO para migraciones desde tu computador. NO se carga en Vercel.
# Neon → Connect → Connection pooling DESACTIVADO. Debe incluir ?sslmode=require
DIRECT_URL=

# ---------- Secretos generados por ustedes (obligatorios) ----------
# Firma las sesiones de Auth.js. Distinta en cada lugar (local, Preview, Production).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Llave de cifrado AES-256-GCM de correo, teléfono y NIT. Exactamente 32 bytes en base64.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Es UNA POR RAMA DE NEON: local y Preview (development) comparten la misma.
# GUARDA UNA COPIA en un gestor de contraseñas: si se pierde, los datos cifrados no se recuperan.
DATA_ENCRYPTION_KEY=

# Secreto HMAC para IPs, correos (correoHash) y la trampa de tiempo. Mínimo 32 caracteres.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Es UNA POR RAMA DE NEON (igual que DATA_ENCRYPTION_KEY).
IP_HASH_SECRET=

# ---------- Cloudflare Turnstile (anti-bots) ----------
# Cloudflare → Turnstile → Add widget. En local pueden usar las llaves de PRUEBA oficiales
# de Cloudflare (siempre aprueban): ver developers.cloudflare.com/turnstile/troubleshooting/testing/
# Llave secreta: solo servidor.
TURNSTILE_SECRET_KEY=
# Llave de sitio: es PÚBLICA a propósito. Es la ÚNICA variable NEXT_PUBLIC_ permitida.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Panel ----------
# Correos de los primeros ADMIN, separados por comas. Solo los usa el script admin:crear (Día 5).
ADMIN_EMAILS=

# ---------- Servicios externos (opcionales hasta su día) ----------
# Resend → API Keys → Create (permiso "Sending access"). Empieza por re_  · Obligatoria desde el Día 4.
RESEND_API_KEY=

# Vercel → Storage → Blob → crear store; Vercel la agrega sola al proyecto.
# Para local: copiarla desde Vercel. Empieza por vercel_blob_rw_  · Obligatoria desde el Día 5.
BLOB_READ_WRITE_TOKEN=
