# Plantilla de variables de entorno de Fesapy.
# Copia este archivo como .env.local y llena los valores. NUNCA subas .env.local a Git.
# En Vercel, carga estas mismas variables en Production y en Preview por separado.

# Base de datos Neon: URL "pooled" (el host contiene "-pooler"). La usa la aplicación.
DATABASE_URL=

# Base de datos Neon: URL directa (sin "-pooler"). La usa Prisma para las migraciones.
DIRECT_URL=

# Secreto de Auth.js para firmar las sesiones. Genéralo con: npx auth secret
AUTH_SECRET=

# Correos que pueden entrar al panel /admin, separados por comas.
ADMIN_EMAILS=

# Clave de Resend para enviar correos (avisos de cotización y enlaces de login).
RESEND_API_KEY=

# Token de Vercel Blob para subir imágenes de productos desde el panel.
BLOB_READ_WRITE_TOKEN=
