// Esquema de la base de datos de Fesapy.
// Modelo de referencia: docs/ARQUITECTURA-Y-SEGURIDAD.md
// Las tablas de Auth.js (Usuario, Sesion, CuentaVerificacion) se agregan el Día 5.
// Regla del equipo: solo una persona a la vez crea migraciones (docs/COLABORACION.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // URL "pooled" de Neon: la usa la aplicación en Vercel.
  url       = env("DATABASE_URL")
  // URL directa de Neon (sin pooler): la usa Prisma para las migraciones.
  directUrl = env("DIRECT_URL")
}

model Categoria {
  id          String     @id @default(cuid())
  nombre      String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(120)
  descripcion String?    @db.VarChar(1000)
  imagen      String?    @db.VarChar(500)
  orden       Int        @default(0)
  productos   Producto[]
}

model Producto {
  id             String    @id @default(cuid())
  nombre         String    @db.VarChar(150)
  slug           String    @unique @db.VarChar(170)
  descripcion    String    @db.VarChar(3000)
  marca          String?   @db.VarChar(100)
  tallas         String[]
  personalizable Boolean   @default(false)
  imagenes       String[]
  destacado      Boolean   @default(false)
  activo         Boolean   @default(true)
  categoriaId    String
  categoria      Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@index([categoriaId])
}

// Empresas que confían en Fesapy.
model Cliente {
  id     String  @id @default(cuid())
  nombre String  @db.VarChar(150)
  logo   String? @db.VarChar(500)
  orden  Int     @default(0)
  activo Boolean @default(true)
}

model Testimonio {
  id      String  @id @default(cuid())
  nombre  String  @db.VarChar(100)
  cargo   String? @db.VarChar(100)
  empresa String? @db.VarChar(150)
  texto   String  @db.VarChar(1000)
  activo  Boolean @default(true)
}

enum EstadoCotizacion {
  NUEVA
  EN_PROCESO
  RESPONDIDA
  CERRADA
}

model Cotizacion {
  id            String           @id @default(cuid())
  nombre        String           @db.VarChar(100)
  empresa       String           @db.VarChar(150)
  nit           String?          @db.VarChar(20)
  correo        String           @db.VarChar(254)
  telefono      String           @db.VarChar(20)
  ciudad        String           @db.VarChar(100)
  mensaje       String           @db.VarChar(2000)
  productos     String?          @db.VarChar(2000)
  // Ley 1581 de 2012: autorización del tratamiento de datos y su fecha.
  aceptaDatos   Boolean
  aceptaDatosEn DateTime
  estado        EstadoCotizacion @default(NUEVA)
  creadaEn      DateTime         @default(now())

  @@index([estado, creadaEn])
}

// Límite de envíos del formulario por IP (ej. 5 por hora).
// Se guarda solo el hash de la IP, nunca la IP real.
model IntentoEnvio {
  id       String   @id @default(cuid())
  ipHash   String   @db.VarChar(64)
  creadoEn DateTime @default(now())

  @@index([ipHash, creadoEn])
}
